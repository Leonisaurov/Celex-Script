}

void loadSource(const char* source) {
  code.source = source;
  code.len = strlen(source);
  code.index = 0;
  code.line = 0;
  code.previus = 0;
}

_Bool isEnd() {
  return code.index >= code.len;
}

char peek() {
  if (isEnd()) return '\0';
  return code.source[code.index];
}

char advance() {
  code.index++;
  return peek();
}

void skipWhitespaces() {
  while(true) {
    switch (peek()) {
    case '\n':
      code.line++;
    case ' ':
    case '\t':
      advance();
    default:
      return;
    }
  }
}

Token makeToken(TokenType type) {
  return (Token) {
    .type = type,
    .line = code.line,
    .start = code.previus,
    .len = code.index++ - (uint64_t) code.previus,
  };
}

Token makeErr(const char* err) {
  return (Token) {
    .type = TOKEN_ERR,
    .start = err,
    .len = strlen(err),
    .line = code.line,
  };
}

_Bool isNumeric(char n) {
  return n >= '0' && n <= '9';
}

_Bool isAlpha(char s) {
  return (s >= 'A' && s <= 'Z') || (s >= 'a' && <= 'z') || s == '_';
}

_Bool isAlphanumeric(char c) {
  return isNumeric(c) || isAlpha(c);
}

Token getToken() {
  skipWhitespaces();
  if (isEnd())
    return makeToken(TOKEN_EOF);
  switch (peek()) {
  case '+': return makeToken(TOKEN_ADD);
  case '-': return makeToken(TOKEN_DEC);
  case '*': return makeToken(TOKEN_MULT);
  case '/': return makeToken(TOKEN_DIV);
    //  case '"': return
  default:
    ;
  }
  return makeErr("Simbolo no reconocido");
}
